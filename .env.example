# Server-side (route handlers, server actions, server components): reachable from the Next.js server
SPRING_API_URL=http://localhost:8080
EXPRESS_API_URL=http://localhost:5000

# Public, baked in at build time (Docker build args). The browser normally goes through /api/x/*.
NEXT_PUBLIC_SPRING_API_URL=http://localhost:8080
NEXT_PUBLIC_EXPRESS_API_URL=http://localhost:5000
